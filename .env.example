# ── Telegram-бот (получите токен у @BotFather) ─────────────────────────────
BOT_TOKEN=

# ── Источники данных, через запятую: mock | telegram | mrkt ─────────────────
# mock = выдуманные демо-данные; telegram = официальный рынок Telegram; mrkt = MRKT (экспериментально).
GIFT_SOURCE=mock

# Нужны для telegram и mrkt (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Заполняется командой: python scripts/make_session.py (пишет сюда сам, на экран не печатает).
# ОТДЕЛЬНЫЙ служебный аккаунт без ценностей, с 2FA. Это секрет уровня пароля от аккаунта.
TG_SESSION_STRING=

# MRKT: список коллекций нужен только если включён mrkt БЕЗ telegram (через запятую).
MRKT_COLLECTIONS=
MRKT_REQUEST_DELAY=2.0
MRKT_PAGE_SIZE=20
MRKT_MAX_PAGES=3

# ── PostgreSQL ────────────────────────────────────────────────────────────
# В docker-compose DATABASE_URL собирается автоматически из переменных ниже.
POSTGRES_USER=gifts
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=gifts
# Для запуска без Docker:
DATABASE_URL=postgresql+asyncpg://gifts:change-me-please@localhost:5432/gifts

# ── Redis (хранилище FSM; пусто = хранить в памяти) ─────────────────────────
REDIS_URL=

# ── Опрос рынка ───────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
# Пауза между запросами к Telegram (защита от FloodWait)
SOURCE_REQUEST_DELAY=1.5
LISTINGS_PER_COLLECTION=50
CATALOG_TTL_SECONDS=900
# Лоты, замеченные не позднее N минут назад, показываются в «Найти подарки»
SEARCH_FRESH_MINUTES=30

# ── Лимиты ────────────────────────────────────────────────────────────────
MAX_FILTERS_PER_USER=10
NOTIFY_RATE_PER_SECOND=20

LOG_LEVEL=INFO

# ── Имя бота в Telegram (бот сам выставляет его при запуске) ──────────────────
BOT_NAME=NFT Tracker

# ── Мини-приложение (Telegram Mini App) ───────────────────────────────────
# Публичный HTTPS-адрес, по которому снаружи доступен веб-сервер бота. Пусто = мини-приложение выключено.
# С доменом: укажите DOMAIN и запустите `docker compose --profile https up -d` (Caddy выпустит сертификат сам).
# Для проверки без домена: cloudflared tunnel --url http://localhost:8080 и вставьте выданный https-адрес.
WEBAPP_URL=
DOMAIN=
# Порт на хосте (только localhost)
WEB_PORT=8080
# Сколько секунд подпись входа из Telegram считается действительной
WEBAPP_AUTH_MAX_AGE=86400
