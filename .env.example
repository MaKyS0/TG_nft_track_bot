# ── Telegram-бот (получите токен у @BotFather) ─────────────────────────────
BOT_TOKEN=

# ── Источник данных: "mock" (демо) или "telethon" (реальный рынок подарков) ──
GIFT_SOURCE=mock

# Нужны только для GIFT_SOURCE=telethon (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Получить: python scripts/make_session.py  (ОТДЕЛЬНЫЙ служебный аккаунт, храните как секрет!)
TG_SESSION_STRING=

# ── PostgreSQL ────────────────────────────────────────────────────────────
# В docker-compose DATABASE_URL собирается автоматически из переменных ниже.
POSTGRES_USER=gifts
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=gifts
# Для запуска без Docker:
DATABASE_URL=postgresql+asyncpg://gifts:change-me-please@localhost:5432/gifts

# ── Redis (хранилище FSM; пусто = хранить в памяти) ─────────────────────────
REDIS_URL=

# ── Опрос рынка ───────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
# Пауза между запросами к Telegram (защита от FloodWait)
SOURCE_REQUEST_DELAY=1.5
LISTINGS_PER_COLLECTION=50
CATALOG_TTL_SECONDS=900
# Лоты, замеченные не позднее N минут назад, показываются в «Найти подарки»
SEARCH_FRESH_MINUTES=30

# ── Лимиты ────────────────────────────────────────────────────────────────
MAX_FILTERS_PER_USER=10
NOTIFY_RATE_PER_SECOND=20

LOG_LEVEL=INFO
